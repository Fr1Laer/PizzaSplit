<Window x:Class="PizzaSplit.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PizzaSplit.WpfApp"
        mc:Ignorable="d"
        Title="Pizza Split" Height="299" Width="286">
    <Grid>
        <TextBox x:Name="PeopleTextBox" HorizontalAlignment="Left" Margin="39,39,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="139" Height="24"/>
        <Label Content="Input the number of people (1-20):" HorizontalAlignment="Left" Margin="39,8,0,0" VerticalAlignment="Top" Width="203"/>
        <TextBox x:Name="AmountTextBox" HorizontalAlignment="Left" Margin="39,111,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="139" Height="24"/>
        <Label Content="Input amount (0 &lt; amount &lt;= 10000)" HorizontalAlignment="Left" Margin="39,80,0,0" VerticalAlignment="Top" Width="218"/>
        <TextBox x:Name="ResultTextBox" HorizontalAlignment="Left" Margin="39,239,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="139" Height="24" IsReadOnly="True"/>
        <Label Content="Result" HorizontalAlignment="Left" Margin="39,208,0,0" VerticalAlignment="Top" Width="183"/>
        <CheckBox x:Name="TipCheckBox" Content="Add 10% tip&#xD;&#xA;" HorizontalAlignment="Left" Margin="39,145,0,0" VerticalAlignment="Top"/>
        <Button Content="Calculate" HorizontalAlignment="Left" Margin="39,176,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.442,-0.274" Width="101" Click="CalculateButton_click"/>

    </Grid>
</Window>
